diff -ru v18/src/storage/VMStorage.sol src/storage/VMStorage.sol
--- v18/src/storage/VMStorage.sol
+++ src/storage/VMStorage.sol
@@ -117,12 +117,12 @@
     internal
     virtual
     override
-    returns (bytes32 id)
+    returns (bytes32 id, bytes32)
   {
-    //* Params validation
-    // Optional
-    if (expiration == 0) {
-      expiration = block.timestamp + DEFAULT_VM_EXPIRATION;
+    // Clamp: 0 or beyond the default lifetime is stored as the default lifetime
+    uint256 maxExpiration = block.timestamp + DEFAULT_VM_EXPIRATION;
+    if (expiration == 0 || expiration > maxExpiration) {
+      expiration = maxExpiration;
     }
     //* Implementation
     bytes32 vmId = _vmIdByPositionHash[positionHash];
@@ -135,7 +135,7 @@
     vm.expiration = uint88(expiration);
     //Event
     emit VmValidated(vmId);
-    return vmId;
+    return (vmId, didHash);
   }
 
   /**
@@ -146,7 +146,9 @@
    */
   function _expireVm(bytes32 didHash, bytes32 id) internal virtual override {
     VerificationMethod storage vm = _vmByNsAndId[didHash][id];
-    if (vm.expiration <= block.timestamp) revert VmAlreadyExpired();
+    uint256 exp = vm.expiration;
+    // A pending VM (never validated, expiration 0) can be withdrawn; an unknown one cannot
+    if (exp == 0 ? vm.id == bytes32(0) : exp <= block.timestamp) revert VmAlreadyExpired();
     vm.expiration = uint88(block.timestamp);
     emit VmExpirationUpdated(didHash, id, true, uint88(block.timestamp));
   }
