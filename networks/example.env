# Copy this file to networks/<name>.env and fill it in, then:
#   make check NETWORK=<name>
# Anything other than local.env and example.env is gitignored.

# Label recorded in .deployments.json and returned by Configuration.getNetwork().
NETWORK_NAME="my-network"

# HTTP JSON-RPC endpoint.
RPC_URL="http://127.0.0.1:8545"

# Expected chain ID. Asserted against the live chain before any broadcast.
CHAIN_ID="31337"

# Exactly ONE signer form. Setting zero or more than one is an error.
#   PRIVATE_KEY  raw key
#   ACCOUNT      foundry keystore account name (preferred: no key on disk in plaintext)
#   MNEMONIC + MNEMONIC_INDEX
PRIVATE_KEY=""
# ACCOUNT=""
# MNEMONIC=""
# MNEMONIC_INDEX="0"

# Explorer verification. Leave VERIFY false unless the chain has an explorer.
VERIFY="false"
ETHERSCAN_API_KEY=""

# Appended verbatim to every forge invocation. Escape hatch for chain quirks:
#   --legacy                                  chain rejects EIP-1559
#   --gas-price 0 --priority-gas-price 0      force zero, BOTH or neither
#   --slow                                    wait for each receipt
FORGE_EXTRA_ARGS=""
